pub fn normalize_subject(subject: &str) -> String {
    let mut value = subject.trim().to_lowercase();
    loop {
        let next = value
            .strip_prefix("re:")
            .or_else(|| value.strip_prefix("fw:"))
            .or_else(|| value.strip_prefix("fwd:"))
            .map(|s| s.trim().to_string());
        match next {
            Some(next) if next != value => value = next,
            _ => break,
        }
    }
    value
}


  function handlePrev() {
    setStepError(null);
    saveMutation.reset();
    setStep((s) => Math.max(s - 1, 1));
  }

  function handleSave() {
    const err = validate(step);
    if (err) { setStepError(err); return; }
    setStepError(null);
    saveMutation.mutate(buildPutBody(draft));
  }


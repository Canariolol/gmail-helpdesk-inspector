# Web
VITE_API_BASE_URL=http://localhost:8080
# Cloud Run web can proxy API paths when this is set.
API_PROXY_TARGET=

# API
API_PORT=8080
# WEB_BASE_URL: origen de la web. Mercado Pago redirige el navegador aquí tras pagar
#   (back_url = WEB_BASE_URL/checkout-return?session_id=...). Debe ser la URL de la WEB.
#   Producción: https://ghmi-web-715291187926.us-central1.run.app
WEB_BASE_URL=http://localhost:5173
# API_BASE_URL: origen de la API. Base del webhook de Mercado Pago
#   (notification_url = API_BASE_URL/billing/mercadopago/webhook). Debe ser la URL de la API.
#   Producción: https://ghmi-api-715291187926.us-central1.run.app
API_BASE_URL=http://localhost:8080
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=Lax
APP_STORAGE=firestore
APP_ENCRYPTION_KEY=change-me-to-32-byte-minimum-secret
APP_SESSION_SECRET=change-me-to-a-long-random-secret

# WorkOS AuthKit (cuenta principal; no es Gmail)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:8080/auth/workos/callback
WORKOS_COOKIE_SECRET=change-me-to-a-long-random-workos-cookie-secret

# Billing / Mercado Pago
BILLING_ENFORCEMENT_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/gmail/connect/callback
GMAIL_MAX_THREADS=50

# Firestore
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Recommended for local/Docker: put the JSON file at
# ./secrets/gcp-service-account.json and keep this container path.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
# Optional short-lived fallback only. Usually expires in about 1 hour.
FIRESTORE_BEARER_TOKEN=

# Programador de análisis diario (lunes a viernes 08:00 America/Santiago)
# Activa el loop interno (para hosts always-on como docker-compose o VPS).
# En Cloud Run se recomienda dejarlo en false y usar Cloud Scheduler contra
# POST /internal/scheduled-analysis con el header x-cron-secret.
SCHEDULER_ENABLED=false
# Secreto compartido del endpoint /internal/scheduled-analysis. Si está vacío,
# el endpoint responde 404.
CRON_SECRET=
# Semilla inicial de la configuración programada (se copia a Firestore en
# scheduleConfigs/{email} la primera vez; después edita el documento).
SCHEDULE_USER_EMAIL=
SCHEDULE_INTERNAL_DOMAINS=
# Opcional: sube el tope de hilos para la ventana de 3 días del lunes.
SCHEDULE_GMAIL_MAX_THREADS=

# Reporte por correo (Resend)
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Helpdesk <reportes@tudominio.cl>"
REPORT_FROM_EMAIL=
# Destinatarios por defecto separados por coma (fallback si el doc de
# configuración no define recipients).
REPORT_TO_EMAIL=

# AI worker / Bedrock
AI_WORKER_URL=http://ai-worker:8090
# Set this to the Cloud Run worker URL when the worker requires authentication.
AI_WORKER_AUDIENCE=
AI_APPLY_CONFIDENCE_THRESHOLD=0.92
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0

# Web
VITE_API_BASE_URL=http://localhost:8080

# API
API_PORT=8080
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
APP_STORAGE=firestore
APP_ENCRYPTION_KEY=change-me-to-32-byte-minimum-secret
APP_SESSION_SECRET=change-me-to-a-long-random-secret

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
GMAIL_MAX_THREADS=50

# Firestore
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Optional for local dev. Prefer short-lived tokens from:
# gcloud auth application-default print-access-token
FIRESTORE_BEARER_TOKEN=
# Optional service account path:
GOOGLE_APPLICATION_CREDENTIALS=

# AI worker / Bedrock
AI_WORKER_URL=http://ai-worker:8090
AI_APPLY_CONFIDENCE_THRESHOLD=0.92
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6


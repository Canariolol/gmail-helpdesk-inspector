# Desarrollo sandbox expuesto por Cloudflare Tunnel.
# Copia esto a .env solo para pruebas sandbox:
#   cp .env.sandbox.example .env
#
# Cloudflare:
# - Hostname publico recomendado: https://mira-dev.ninfasolutions.com
# - El tunnel debe apuntar a http://caddy:80 usando docker-compose.tunnel.yml.

# Web
# Vacio = llamadas same-origin. Caddy enruta /auth, /gmail, /checkout, /billing, etc. a la API.
VITE_API_BASE_URL=
VITE_MERCADOPAGO_PUBLIC_KEY=tu-public-key-sandbox
API_PROXY_TARGET=

# API publica via tunnel/Caddy
API_PORT=8080
WEB_BASE_URL=https://mira-dev.ninfasolutions.com
API_BASE_URL=https://mira-dev.ninfasolutions.com
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=Lax
APP_STORAGE=firestore
APP_ENCRYPTION_KEY=change-me-to-32-byte-minimum-secret
APP_SESSION_SECRET=change-me-to-a-long-random-secret

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=

# WorkOS AuthKit sandbox/dev
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=https://mira-dev.ninfasolutions.com/auth/workos/callback
WORKOS_COOKIE_SECRET=change-me-to-a-long-random-workos-cookie-secret

# Billing / Mercado Pago sandbox
BILLING_ENFORCEMENT_ENABLED=true
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-sandbox
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret-sandbox

# Cuentas internas privilegiadas
INTERNAL_FULL_ACCESS_EMAILS=

# Google OAuth / Gmail sandbox/dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://mira-dev.ninfasolutions.com/gmail/connect/callback
GMAIL_MAX_THREADS=50

# Firestore
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
FIRESTORE_BEARER_TOKEN=

# Scheduler local
SCHEDULER_ENABLED=false
CRON_SECRET=
SCHEDULE_USER_EMAIL=
SCHEDULE_INTERNAL_DOMAINS=
SCHEDULE_GMAIL_MAX_THREADS=

# Reportes
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=

# AI worker / Bedrock
AI_WORKER_URL=http://ai-worker:8090
AI_WORKER_AUDIENCE=
AI_APPLY_CONFIDENCE_THRESHOLD=0.92
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
BEDROCK_BATCH_MODEL_ID=

# Produccion live en Cloud Run.
# Copia valores a Secret Manager / Cloud Run, no a git.

# Dominio publico de la web
PUBLIC_WEB_URL=https://mira.ninfasolutions.com

# URL real del servicio API en Cloud Run.
# Mercado Pago debe llamar ESTE webhook, no el dominio publico de la web:
#   ${CLOUD_RUN_API_URL}/billing/mercadopago/webhook
CLOUD_RUN_API_URL=https://ghmi-api-<project-number>.<region>.run.app

# Web
# Vacio = same-origin. ghmi-web proxya rutas API hacia API_PROXY_TARGET.
VITE_API_BASE_URL=
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-live
API_PROXY_TARGET=${CLOUD_RUN_API_URL}

# API
APP_ENV=production
WEB_BASE_URL=${PUBLIC_WEB_URL}
API_BASE_URL=${CLOUD_RUN_API_URL}
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=Lax
APP_STORAGE=firestore
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_BEARER_TOKEN=

# WorkOS live
WORKOS_CLIENT_ID=
WORKOS_API_KEY=secret-manager:workos-api-key
WORKOS_REDIRECT_URI=${PUBLIC_WEB_URL}/auth/workos/callback
WORKOS_COOKIE_SECRET=secret-manager:workos-cookie-secret

# Google OAuth live
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=secret-manager:google-client-secret
GOOGLE_REDIRECT_URL=${PUBLIC_WEB_URL}/gmail/connect/callback
GMAIL_MAX_THREADS=100

# Mercado Pago live
BILLING_ENFORCEMENT_ENABLED=true
MERCADOPAGO_ACCESS_TOKEN=secret-manager:mercadopago-access-token-live
MERCADOPAGO_WEBHOOK_SECRET=secret-manager:mercadopago-webhook-secret-live

# App secrets
APP_ENCRYPTION_KEY=secret-manager:app-encryption-key
APP_SESSION_SECRET=secret-manager:app-session-secret

# Scheduler en Cloud Run: usar Cloud Scheduler, no loop interno.
SCHEDULER_ENABLED=false
CRON_SECRET=secret-manager:cron-secret
SCHEDULE_USER_EMAIL=
SCHEDULE_INTERNAL_DOMAINS=
SCHEDULE_GMAIL_MAX_THREADS=

# Reportes
RESEND_API_KEY=secret-manager:resend-api-key
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=

# AI worker / Bedrock
AI_WORKER_URL=
AI_WORKER_AUDIENCE=
AI_APPLY_CONFIDENCE_THRESHOLD=0.92
AWS_BEARER_TOKEN_BEDROCK=secret-manager:bedrock-token
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
BEDROCK_BATCH_MODEL_ID=
